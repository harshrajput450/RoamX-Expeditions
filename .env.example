# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SUPABASE CONFIGURATION (PostgreSQL + Supabase Storage for permanent data & media persistence)
# Set your Supabase project URL and API keys from your Supabase Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RAZORPAY PAYMENT GATEWAY
# Razorpay Key ID and Secret from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id"
